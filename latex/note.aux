\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Results}{4}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces $K=1$ test accuracy vs.\ $\sigma $ under the corrected sampler, on the paper's data split (200 train / 2000 test). Each model gets $N=100$ perturbations per $\sigma $. The dashed line marks the paper's $\sigma =0.005$. Our grid brackets this value with $\sigma =0.003$ and $\sigma =0.01$; interpolating, all models appear to be at or near the destructive regime at $\sigma =0.005$. When each model is allowed its own optimal $\sigma $ ($\sim $0.001), peak $K=1$ accuracy scales monotonically with model size.\relax }}{5}{figure.caption.10}\protected@file@percent }
\newlabel{fig:k1_vs_sigma}{{2}{5}{$K=1$ test accuracy vs.\ $\sigma $ under the corrected sampler, on the paper's data split (200 train / 2000 test). Each model gets $N=100$ perturbations per $\sigma $. The dashed line marks the paper's $\sigma =0.005$. Our grid brackets this value with $\sigma =0.003$ and $\sigma =0.01$; interpolating, all models appear to be at or near the destructive regime at $\sigma =0.005$. When each model is allowed its own optimal $\sigma $ ($\sim $0.001), peak $K=1$ accuracy scales monotonically with model size.\relax }{figure.caption.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Issue 3: Parameter Scales Are Not Uniform}{5}{section.4}\protected@file@percent }
\newlabel{sec:scales}{{4}{5}{Issue 3: Parameter Scales Are Not Uniform}{section.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Hit-rate (fraction of perturbations exceeding base accuracy by at least margin $m$) vs.\ $\sigma $, under the corrected sampler. Left: $m=0$ (any improvement). Center: $m=0.02$. Right: $m=0.05$. At $m=0$, all models show nonzero hit-rates; at stricter margins, larger models generally retain higher hit-rates, though the ordering is not cleanly monotonic at all $\sigma $ values. The curves are noisy at $N=100$.\relax }}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:hitrate_vs_sigma}{{3}{6}{Hit-rate (fraction of perturbations exceeding base accuracy by at least margin $m$) vs.\ $\sigma $, under the corrected sampler. Left: $m=0$ (any improvement). Center: $m=0.02$. Right: $m=0.05$. At $m=0$, all models show nonzero hit-rates; at stricter margins, larger models generally retain higher hit-rates, though the ordering is not cleanly monotonic at all $\sigma $ values. The curves are noisy at $N=100$.\relax }{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Relative-norm perturbation experiment}{6}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Weighted mean parameter std by component type across model scales. Embedding, attention, MLP, and unembedding weights all cluster in the $\sim $0.01--0.03 range; norm layers are 10--30$\times $ larger. The dotted line marks $\sigma =0.005$: under the paper's perturbation scheme, weight matrices receive a 20--30\% relative perturbation while norms receive $<$1\%. For 0.5B--3B (tied embeddings), unembedding std equals embedding std; 7B and 32B have separate unembedding matrices. Note that 7B has the smallest weight matrix stds, meaning the same $\sigma $ is relatively more disruptive there.\relax }}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:weight_scales}{{4}{7}{Weighted mean parameter std by component type across model scales. Embedding, attention, MLP, and unembedding weights all cluster in the $\sim $0.01--0.03 range; norm layers are 10--30$\times $ larger. The dotted line marks $\sigma =0.005$: under the paper's perturbation scheme, weight matrices receive a 20--30\% relative perturbation while norms receive $<$1\%. For 0.5B--3B (tied embeddings), unembedding std equals embedding std; 7B and 32B have separate unembedding matrices. Note that 7B has the smallest weight matrix stds, meaning the same $\sigma $ is relatively more disruptive there.\relax }{figure.caption.12}{}}
