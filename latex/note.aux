\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces RandOpt ensemble accuracy on Countdown under the released (correlated) and corrected (isotropic) samplers. $N=40$, mixed $\sigma $, 100 train / 100 test samples. The released sampler is modestly better at 1.5B and 3B, especially at small $K$. At 7B, the corrected sampler is comparable. At no scale does fixing the RNG cause the method to collapse.\relax }}{3}{figure.caption.7}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:rng_ab}{{1}{3}{RandOpt ensemble accuracy on Countdown under the released (correlated) and corrected (isotropic) samplers. $N=40$, mixed $\sigma $, 100 train / 100 test samples. The released sampler is modestly better at 1.5B and 3B, especially at small $K$. At 7B, the corrected sampler is comparable. At no scale does fixing the RNG cause the method to collapse.\relax }{figure.caption.7}{}}
